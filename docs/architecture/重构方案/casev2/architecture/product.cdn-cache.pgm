// CDN 边缘缓存架构
// @role: product  (authoritative: filename prefix)
// Mermaid 对照: graph + subgraph 边缘/源站分组
diagram architecture {
    title: "CDN 边缘缓存架构"

    group edge "边缘节点" {
        entity[frontend] user "终端用户" {
            semantic: browser
        }
        entity[gateway] edge_pop "边缘 POP" {
            semantic: nginx
        }
        entity[cache] edge_cache "边缘缓存" {
            semantic: redis
        }
    }

    group origin "源站" {
        entity[gateway] origin_lb "回源负载均衡" {
            semantic: nginx
        }
        entity[service] origin_svc "源站服务"
        entity[database] origin_db "源站数据库" {
            semantic: postgres
        }
    }

    entity[external] dns "DNS 调度"

    user -> dns "域名解析"
    dns -> edge_pop "就近调度"
    user -> edge_pop "请求"
    edge_pop -> edge_cache "查询缓存"
    edge_cache --> edge_pop "命中"
    edge_pop -> origin_lb "未命中回源"
    origin_lb -> origin_svc
    origin_svc -> origin_db
    origin_svc --> edge_cache "回源填充缓存"
}
