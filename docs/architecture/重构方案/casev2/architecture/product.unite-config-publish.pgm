// Unite Config 发布与热加载：Console 发布链路 → 运行时双模式拉取
// Mermaid 对照:
// flowchart TB
//     subgraph Console
//         A[业务 Service] --> B[UniteConfigPublishService]
//         B --> C[(MySQL)] B --> D[(Cassandra)] B --> E[MandaConsoleNotifyService]
//         E --> G D --> F[unite-config-server REST] --> H
//     end
//     subgraph Runtime
//         G[DB 模式 data-server] --> I H[HTTP 模式 app-engine] --> I[UniteConfigMap + Listener] --> J[热加载业务逻辑]
//     end
// @role: product  (authoritative: filename prefix)
diagram architecture {
    title: "Unite Config 发布与热加载"

    group console "Console" {
        entity[service] biz_services "业务 Service\nDictService / RazorEnginePublish 等"
        entity[service] publish_svc "UniteConfigPublishService"
        entity[database] mysql_configs "MySQL unite_configs" {
            semantic: mysql
        }
        entity[database] cassandra_config "Cassandra unite_config"
        entity[service] notify_svc "MandaConsoleNotifyService"
        entity[gateway] config_server "unite-config-server REST"
    }

    group runtime "运行时服务" {
        entity[service] db_client "DB 模式客户端\ndata-server"
        entity[service] http_client "HTTP 模式客户端\napp-engine"
        entity[service] config_map "UniteConfigMap + Listener"
        entity[service] hot_reload "热加载业务逻辑"
    }

    biz_services -> publish_svc
    publish_svc -> mysql_configs
    publish_svc -> cassandra_config
    publish_svc -> notify_svc
    notify_svc -> db_client
    cassandra_config -> config_server
    config_server -> http_client
    db_client -> config_map
    http_client -> config_map
    config_map -> hot_reload
}
