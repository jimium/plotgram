// constrain 示例：无业务边强制 sink 沉底
// @role: mech  (authoritative: filename prefix)
//
// side 与 end 之间没有业务边，但 `constrain side -> end` 强制 end 在下游。
diagram flowchart {
    title: "constrain sink"

    entity[start] start "开始"
    entity[process] a "处理"
    entity[process] side "旁路"
    entity[end] end "结束"

    start -> a
    a -> side
    side -> a
    a -> end

    // 隐形硬约束：side 上游、end 下游（不画边）
    constrain side -> end
}
