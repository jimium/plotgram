{
  "id": "common.floating-cards",
  "name": "Floating Cards",
  "extends": "common.clean-light",
  "tokens": {
    "colors": {
      "canvas": "#E2E2E6",
      "neutral_fill": "#FFFFFF",
      "neutral_stroke": "#C9C9C9",
      "edge_stroke": "#A8A8B0",
      "group_fill": "#FFFFFF",
      "group_stroke": "#C4C4CB",
      "border_strong": "#C4C4CB"
    }
  },
  "defaults": {
    "group": {
      "fill": "{colors.group_fill}",
      "stroke": "{colors.group_stroke}",
      "stroke_width": 1.25,
      "stroke_dasharray": "none"
    }
  }
}
