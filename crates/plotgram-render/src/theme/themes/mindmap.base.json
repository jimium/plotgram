{
  "id": "mindmap.base",
  "name": "Mindmap Base",
  "extends": null,
  "tokens": {
    "colors": {
      "canvas": "#FFFFFF",
      "text": "#2D3436",
      "muted_text": "#636E72",
      "border": "#DFE6E9",
      "primary": "#6C5CE7",
      "neutral_fill": "#F8F9FA",
      "neutral_stroke": "#B2BEC3",
      "edge_stroke": "#B2BEC3",
      "arrow_fill": "#636E72",
      "group_fill": "#F1F2F6",
      "group_stroke": "#B2BEC3"
    },
    "palette": {
      "root": {
        "fill": "#6C5CE7",
        "stroke": "#5A4BD1",
        "text_fill": "#FFFFFF"
      }
    },
    "typography": {
      "font_family": "'Noto Sans CJK SC', 'Segoe UI', sans-serif",
      "title_size": 16,
      "label_size": 13,
      "small_size": 11,
      "font_weight_regular": 400,
      "font_weight_medium": 500,
      "font_weight_bold": 700
    },
    "strokes": {
      "thin": 1.0,
      "normal": 1.5,
      "thick": 2.0,
      "dashed": [
        6,
        3
      ],
      "dotted": [
        2,
        4
      ]
    },
    "radius": {
      "sm": 4,
      "md": 8,
      "lg": 12,
      "pill": 999
    },
    "spacing": {
      "node_padding_x": 12,
      "node_padding_y": 8,
      "group_padding": 16,
      "label_gap": 6
    }
  },
  "defaults": {
    "canvas": {
      "background": "{colors.canvas}"
    },
    "title": {
      "fill": "{colors.text}",
      "font_size": "{typography.title_size}",
      "font_weight": "{typography.font_weight_bold}"
    },
    "node": {
      "fill": "{colors.neutral_fill}",
      "stroke": "{colors.neutral_stroke}",
      "stroke_width": "{strokes.normal}",
      "text_fill": "{colors.text}",
      "font_size": "{typography.label_size}",
      "radius": "{radius.lg}",
      "shape": "rounded_rect",
      "stroke_linecap": "round",
      "stroke_linejoin": "round"
    },
    "edge": {
      "stroke": "{colors.neutral_stroke}",
      "stroke_width": "{strokes.normal}",
      "text_fill": "{colors.muted_text}",
      "font_size": "{typography.small_size}",
      "stroke_linecap": "round",
      "stroke_linejoin": "round",
      "stroke_opacity": 0.7,
      "arrow_style": "none",
      "arrow_fill": "{colors.arrow_fill}",
      "label_bg": "canvas",
      "label_bg_opacity": 1.0
    },
    "group": {
      "fill": "{colors.group_fill}",
      "stroke": "{colors.group_stroke}",
      "stroke_width": "{strokes.normal}",
      "text_fill": "{colors.muted_text}",
      "radius": "{radius.sm}"
    }
  },
  "kind_styles": {
    "root": {
      "shape": "circle",
      "fill": "{role.root.fill}",
      "stroke": "{role.root.stroke}",
      "text_fill": "{role.root.text_fill}",
      "font_size": "{typography.title_size}",
      "font_weight": "bold"
    },
    "main": {
      "shape": "rounded_rect",
      "font_size": "{typography.label_size}",
      "font_weight": "medium"
    },
    "branch": {
      "shape": "rounded_rect"
    },
    "leaf": {
      "shape": "rounded_rect",
      "stroke": "transparent",
      "font_size": "{typography.small_size}"
    }
  }
}
