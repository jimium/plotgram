{
  "id": "common.clean-dark",
  "name": "Clean Dark",
  "extends": null,
  "tokens": {
    "colors": {
      "canvas": "#131316",
      "text": "#E7E5E4",
      "muted_text": "#78716C",
      "border": "#2D2D33",
      "border_strong": "#3F3F46",
      "primary": "#818CF8",
      "neutral_fill": "#1C1C21",
      "neutral_stroke": "#2D2D33",
      "edge_stroke": "#52525B",
      "arrow_fill": "#818CF8",
      "group_fill": "transparent",
