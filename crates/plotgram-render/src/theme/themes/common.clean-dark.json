    },
    "palette": {
      "blue": {
        "fill": "#1E1B4B",
        "stroke": "#4338CA",
        "text_fill": "#C7D2FE"
      },
      "orange": {
        "fill": "#431407",
        "stroke": "#9A3412",
        "text_fill": "#FED7AA"
      },
      "green": {
        "fill": "#022C22",
        "stroke": "#047857",
        "text_fill": "#A7F3D0"
      },
      "purple": {
        "fill": "#2E1065",
        "stroke": "#6D28D9",
        "text_fill": "#DDD6FE"
