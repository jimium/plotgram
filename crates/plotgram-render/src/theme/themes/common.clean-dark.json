    "final": {
      "shape": "circle",
      "fill": "{role.end_red.fill}",
      "stroke": "{role.end_red.stroke}",
      "text_fill": "{role.end_red.text_fill}",
      "radius": 14,
      "stroke_width": 2.0
    },
    "choice": {
      "shape": "diamond",
      "fill": "{role.amber.fill}",
      "stroke": "{role.amber.stroke}",
      "text_fill": "{role.amber.text_fill}"
