      },
      "gray": {
        "fill": "#1C1C21",
        "stroke": "#2D2D33",
        "text_fill": "#D6D3D1"
      },
      "amber": {
        "fill": "#451A03",
        "stroke": "#B45309",
        "text_fill": "#FDE68A"
      },
      "blue_gray": {
        "fill": "#18181B",
        "stroke": "#27272A",
        "text_fill": "#D4D4D8"
      },
      "start_green": {
        "fill": "#059669",
        "stroke": "#10B981",
        "text_fill": "#FFFFFF"
      },
      "end_red": {
        "fill": "#E11D48",
        "stroke": "#FB7185",
        "text_fill": "#FFFFFF"
      },
      "arch_blue": {
        "fill": "#1E1B4B",
