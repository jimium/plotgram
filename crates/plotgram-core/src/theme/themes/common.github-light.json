{
  "version": "0.2",
  "id": "common.github-light",
  "name": "GitHub Light",
  "meta": {
    "author": "Plotgram",
    "description": "灵感来自 GitHub Primer 浅色主题：开发者最熟悉的白底蓝链配色，适合 README 与文档嵌入",
    "tags": ["github", "primer", "light", "inspired"]
  },
  "extends": "common.clean-light",
  "tokens": {
    "colors": {
      "canvas": "#ffffff",
      "text": "#1f2328",
      "muted_text": "#656d76",
      "border": "#d0d7de",
      "primary": "#0969da",
      "neutral_fill": "#f6f8fa",
      "neutral_stroke": "#656d76",
      "edge_stroke": "#8c959f",
      "group_fill": "#f6f8fa",
      "group_stroke": "#d0d7de"
    },
    "palette": {
      "blue": { "fill": "#ddf4ff", "stroke": "#0969da" },
      "orange": { "fill": "#fff1e5", "stroke": "#bc4c00" },
      "green": { "fill": "#dafbe1", "stroke": "#1a7f37" },
      "purple": { "fill": "#fbefff", "stroke": "#8250df" },
      "yellow": { "fill": "#fff8c5", "stroke": "#9a6700" },
      "red": { "fill": "#ffebe9", "stroke": "#cf222e" },
      "cyan": { "fill": "#b6e3ff", "stroke": "#0598bc" },
      "brown": { "fill": "#f0f0f0", "stroke": "#57606a" },
      "gray": { "fill": "#f6f8fa", "stroke": "#8c959f" },
      "amber": { "fill": "#fff1e5", "stroke": "#bc4c00" },
      "blue_gray": { "fill": "#f6f8fa", "stroke": "#656d76" },
      "start_green": { "fill": "#dafbe1", "stroke": "#1a7f37" },
      "end_red": { "fill": "#ffebe9", "stroke": "#cf222e" },
      "arch_blue": { "fill": "#ddf4ff", "stroke": "#0969da" },
      "root": { "fill": "#0969da", "stroke": "#0550ae", "text_fill": "#ffffff" }
    }
  },
  "defaults": {
    "edge": {
      "stroke_opacity": 0.9
    }
  },
  "diagrams": {
    "flowchart": {
      "edge": { "stroke": "{colors.edge_stroke}" }
    },
    "sequence": {
      "edge": { "stroke": "{colors.edge_stroke}" }
    },
    "state": {
      "edge": { "stroke": "{colors.edge_stroke}" }
    },
    "architecture": {
      "edge": { "stroke": "{colors.border}" }
    },
    "er": {
      "node": { "fill": "#ffffff", "stroke": "#0969da" },
      "edge": { "stroke": "{colors.border}" }
    },
    "mindmap": {
      "entity_types": {
        "leaf": { "fill": "#f6f8fa" }
      },
      "context_palettes": {
        "branch": {
          "entries": [
            { "fill": "#ddf4ff", "stroke": "#0969da", "text_fill": "#0550ae", "edge_stroke": "#54aeff" },
            { "fill": "#dafbe1", "stroke": "#1a7f37", "text_fill": "#116329", "edge_stroke": "#4ac26b" },
            { "fill": "#ffebe9", "stroke": "#cf222e", "text_fill": "#a40e26", "edge_stroke": "#ff8182" },
            { "fill": "#fff1e5", "stroke": "#bc4c00", "text_fill": "#953800", "edge_stroke": "#fb8f44" },
            { "fill": "#fbefff", "stroke": "#8250df", "text_fill": "#6639ba", "edge_stroke": "#b083f0" },
            { "fill": "#b6e3ff", "stroke": "#0598bc", "text_fill": "#0c6b84", "edge_stroke": "#56d4dd" }
          ]
        }
      }
    }
  }
}
