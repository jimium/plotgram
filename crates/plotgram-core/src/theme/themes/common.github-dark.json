{
  "version": "0.2",
  "id": "common.github-dark",
  "name": "GitHub Dark",
  "meta": {
    "author": "Plotgram",
    "description": "灵感来自 GitHub Primer 深色主题：#0d1117 底 + 蓝绿语义色，适合深色文档站与 IDE 预览",
    "tags": ["github", "primer", "dark", "inspired"]
  },
  "extends": "common.clean-dark",
  "tokens": {
    "colors": {
      "canvas": "#0d1117",
      "text": "#e6edf3",
      "muted_text": "#7d8590",
      "border": "#30363d",
      "primary": "#4493f8",
      "neutral_fill": "#161b22",
      "neutral_stroke": "#7d8590",
      "edge_stroke": "#484f58",
      "group_fill": "#161b22",
      "group_stroke": "#30363d"
    },
    "palette": {
      "blue": { "fill": "#0f1d2f", "stroke": "#4493f8" },
      "orange": { "fill": "#1d160d", "stroke": "#db6d28" },
      "green": { "fill": "#0c2014", "stroke": "#3fb950" },
      "purple": { "fill": "#1a1226", "stroke": "#a371f7" },
      "yellow": { "fill": "#1f1a0a", "stroke": "#d29922" },
      "red": { "fill": "#201013", "stroke": "#f85149" },
      "cyan": { "fill": "#0a1c25", "stroke": "#39c5cf" },
      "brown": { "fill": "#161b22", "stroke": "#6e7681" },
      "gray": { "fill": "#0d1117", "stroke": "#484f58" },
      "amber": { "fill": "#1d160d", "stroke": "#db6d28" },
      "blue_gray": { "fill": "#161b22", "stroke": "#8b949e" },
      "start_green": { "fill": "#0c2014", "stroke": "#3fb950" },
      "end_red": { "fill": "#201013", "stroke": "#f85149" },
      "arch_blue": { "fill": "#0f1d2f", "stroke": "#4493f8" },
      "root": { "fill": "#1f6feb", "stroke": "#4493f8", "text_fill": "#ffffff" }
    }
  },
  "defaults": {
    "edge": {
      "stroke_opacity": 0.7
    }
  },
  "diagrams": {
    "architecture": {
      "group": {
        "stroke": "{colors.group_stroke}",
        "stroke_width": "{strokes.normal}"
      },
      "edge": { "stroke": "{colors.border}" },
      "context_palettes": {
        "group_nest": {
          "entries": [
            { "fill": "{darken({colors.group_fill}, 0.0)}", "stroke": "{darken({colors.group_stroke}, 0.0)}", "stroke_width": 2.0, "border_radius": 8.0, "stroke_dasharray": "none", "stroke_opacity": 0.9 },
            { "fill": "{darken({colors.group_fill}, 0.10)}", "stroke": "{darken({colors.group_stroke}, 0.10)}", "stroke_width": 1.5, "border_radius": 6.0, "stroke_dasharray": "none", "stroke_opacity": 0.7 },
            { "fill": "{darken({colors.group_fill}, 0.18)}", "stroke": "{darken({colors.group_stroke}, 0.18)}", "stroke_width": 1.5, "border_radius": 6.0, "stroke_dasharray": "none", "stroke_opacity": 0.5 },
            { "fill": "{darken({colors.group_fill}, 0.25)}", "stroke": "{darken({colors.group_stroke}, 0.25)}", "stroke_width": 1.5, "border_radius": 6.0, "stroke_dasharray": "none", "stroke_opacity": 0.35 }
          ]
        }
      }
    },
    "er": {
      "node": {
        "fill": "#161b22",
        "stroke": "#4493f8"
      },
      "edge": { "stroke": "{colors.border}" }
    },
    "flowchart": {
      "edge": { "stroke": "{colors.edge_stroke}" }
    },
    "sequence": {
      "edge": { "stroke": "{colors.edge_stroke}" }
    },
    "state": {
      "edge": { "stroke": "{colors.edge_stroke}" }
    },
    "mindmap": {
      "entity_types": {
        "leaf": {
          "fill": "#1c2128"
        }
      },
      "context_palettes": {
        "branch": {
          "entries": [
            { "fill": "#0f1d2f", "stroke": "#4493f8", "edge_stroke": "#388bfd", "text_fill": "#9ec5ff" },
            { "fill": "#0c2014", "stroke": "#3fb950", "edge_stroke": "#2ea043", "text_fill": "#7ee787" },
            { "fill": "#201013", "stroke": "#f85149", "edge_stroke": "#da3633", "text_fill": "#ff9492" },
            { "fill": "#1d160d", "stroke": "#db6d28", "edge_stroke": "#d1622e", "text_fill": "#ffb757" },
            { "fill": "#1a1226", "stroke": "#a371f7", "edge_stroke": "#8957e5", "text_fill": "#d2a8ff" },
            { "fill": "#0a1c25", "stroke": "#39c5cf", "edge_stroke": "#27a8b2", "text_fill": "#79e3eb" }
          ]
        }
      }
    }
  }
}
