// 两团经桥相连：每团一圈，桥是区际骨架，不是全体挤成一个圆
diagram {
    title: "双团拓扑",
    layout: circular

    node a0 "核心A"
    node a1 "A1"
    node a2 "A2"
    node a3 "A3"

    node b0 "核心B"
    node b1 "B1"
    node b2 "B2"
    node b3 "B3"

    a0 -> a1
    a1 -> a2
    a2 -> a3
    a3 -> a0
    a0 -> a2
    a1 -> a3

    b0 -> b1
    b1 -> b2
    b2 -> b3
    b3 -> b0
    b0 -> b2
    b1 -> b3

    a0 -> b0
}
