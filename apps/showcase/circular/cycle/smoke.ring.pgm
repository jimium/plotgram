// 单环：弱连通分量全体 CYCLE（Circular M0）
diagram {
    title: "协议环",
    layout: circular {
        partitioning: single-cycle,
        order: declaration
    }

    node n0 "N0"
    node n1 "N1"
    node n2 "N2"
    node n3 "N3"
    node n4 "N4"
    node n5 "N5"

    n0 -> n1
    n1 -> n2
    n2 -> n3
    n3 -> n4
    n4 -> n5
    n5 -> n0
}
