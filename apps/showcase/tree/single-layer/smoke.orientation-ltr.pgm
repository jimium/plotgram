// 与 smoke.root-branches 同拓扑，朝向 LTR（OrientationStage）
diagram {
    title: "学习计划 · LTR",
    layout: tree {
        placer: layered,
        orientation: left-to-right
    }

    node plan "学习计划"
    node rust "Rust"
    node algo "算法"
    node eng "英语"

    plan -> rust
    plan -> algo
    plan -> eng
}
