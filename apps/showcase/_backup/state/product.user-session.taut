// 用户会话生命周期
// @role: product  (authoritative: filename prefix)
// Mermaid 对照: stateDiagram-v2 登录/登出/过期流转
diagram state {
    title: "用户会话生命周期"

    entity[initial] init ""
    entity[state] guest "访客"
    entity[state] logging_in "登录中"
    entity[state] active "已登录"
    entity[state] idle "空闲"
    entity[state] expired "已过期"
    entity[final] logged_out "已登出"

    init -> guest
    guest -> logging_in "提交凭证"
    logging_in -> active "认证成功"
    logging_in -> guest "认证失败"
    active -> idle "5 分钟无操作"
    idle -> active "恢复操作"
    idle -> expired "超过 30 分钟"
    active -> logged_out "主动登出"
    expired -> logged_out "跳转登录页"
}
