// stress 压测：8 节点近全连通网格（SGD stress 收敛 + 重叠解除）
diagram {
    title: "稠密网格",
    layout: organic {
        iterations: 500,
        seed: 42
    }

    node m0 "M0"
    node m1 "M1"
    node m2 "M2"
    node m3 "M3"
    node m4 "M4"
    node m5 "M5"
    node m6 "M6"
    node m7 "M7"

    m0 -> m1
    m0 -> m2
    m0 -> m3
    m1 -> m2
    m1 -> m4
    m2 -> m5
    m3 -> m4
    m3 -> m6
    m4 -> m5
    m4 -> m7
    m5 -> m7
    m6 -> m7
    m6 -> m1
    m7 -> m3
}
