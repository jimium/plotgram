// 微服务结账：多服务协作 + 异步回调
diagram {
    profile: sequence,
    title: "微服务结账流程"

    node user "用户" actor
    node web "Web 前端" client
    node gateway "API 网关" gateway
    node order "订单服务" service
    node inventory "库存服务" service
    node payment "支付服务" service
    node notify "通知服务" service
    node mq "消息队列" service

    user -> web "提交订单"
    web -> gateway "POST /checkout"
    gateway -> order "创建订单"
    order -> inventory "锁定库存"
    inventory --> order "锁定成功"
    order -> payment "发起支付"
    payment --> order "支付成功"
    order -> mq "发布订单完成事件"
    mq --> notify "消费事件"
    notify --> user "发送确认邮件"
    order --> gateway "订单结果"
    gateway --> web "结账完成"
    web --> user "显示成功页"
}
