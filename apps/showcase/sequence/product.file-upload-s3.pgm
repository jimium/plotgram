// 文件上传对象存储：预签名直传 + 回调确认
diagram {
    profile: sequence,
    title: "文件上传对象存储时序"

    node user "用户" actor
    node web "Web 前端" client
    node api "上传服务" service
    node metadb "元数据库" database
    node oss "对象存储" service

    user -> web "选择文件"
    web -> api "申请预签名 URL"
    api -> metadb "创建上传记录"
    metadb --> api "记录已创建"
    api --> web "返回预签名 URL"
    web -> oss "直传文件内容"
    oss --> web "上传完成"
    web -> api "通知上传完成"
    api -> metadb "更新状态为已完成"
    api --> web "返回文件访问地址"
    web --> user "展示上传成功"
}
