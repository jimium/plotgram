// API 调用链：网关 → 服务 → 数据库
diagram {
    profile: sequence,
    title: "API 调用链"

    node client "客户端" client
    node gateway "API 网关" gateway
    node user_svc "用户服务" service
    node db "数据库" database

    client -> gateway "GET /users/me"
    gateway -> user_svc "转发请求"
    user_svc -> db "查询用户"
    db --> user_svc "返回记录"
    user_svc --> gateway "用户信息"
    gateway --> client "200 OK"
}
