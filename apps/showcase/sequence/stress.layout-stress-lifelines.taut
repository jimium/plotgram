// 密集消息、自调用、长跨度回调
diagram {
    profile: sequence,
    title: "布局测试：密集时序消息与长跨度回调"

    node client "移动端" client
    node gateway "API 网关" gateway
    node svc_a "微服务 A" service
    node svc_b "微服务 B" service
    node db "分布式数据库" database

    client -> gateway "发起同步请求"
    gateway -> svc_a "路由转发"
    svc_a -> svc_a "内部参数校验"
    svc_a -> db "查询权限数据"
    db --> svc_a "返回权限结果"
    svc_a -> svc_b "投递异步计算任务"
    svc_a --> gateway "快速返回 Ack"
    gateway --> client "202 Accepted"
    svc_b -> svc_b "资源初始化"
    svc_b -> db "写入计算中间态"
    db --> svc_b "写入成功"
    svc_b -> svc_a "任务完成回调通知"
    svc_a -> client "WebSocket 推送最终结果"
    client -> client "界面渲染更新"
}
