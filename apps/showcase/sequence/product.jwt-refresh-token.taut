// JWT 令牌刷新：Access Token 过期后用 Refresh Token 续期
diagram {
    profile: sequence,
    title: "JWT 令牌刷新时序"

    node user "用户" actor
    node spa "前端应用" client
    node api "业务 API" service
    node auth "认证服务" service
    node store "Token 存储" database

    user -> spa "发起业务操作"
    spa -> api "携带 Access Token 请求"
    api --> spa "401 Token 已过期"
    spa -> auth "提交 Refresh Token"
    auth -> store "校验 Refresh Token"
    store --> auth "校验通过"
    auth --> spa "下发新 Access Token"
    spa -> api "重试业务请求"
    api --> spa "返回业务数据"
    spa --> user "展示结果"
}
