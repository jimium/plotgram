// OAuth 授权码流程
diagram {
    profile: sequence,
    title: "OAuth 授权码登录"

    node user "用户" actor
    node browser "浏览器" client
    node auth "认证服务" service
    node resource "资源服务" service

    user -> browser "点击登录"
    browser -> auth "重定向到授权页"
    user -> auth "输入凭证"
    auth --> browser "返回授权码"
    browser -> auth "用授权码换 Token"
    auth --> browser "返回 Access Token"
    browser -> resource "携带 Token 请求资源"
    resource --> browser "返回受保护数据"
}
