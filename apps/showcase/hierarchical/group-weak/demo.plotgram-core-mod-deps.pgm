// drawify-core 内部 mod 依赖关系（编译期 DAG）
// 说明：箭头表示「use / 依赖」方向（A -> B 表示 A 依赖 B）
// d2-exempt: group-penetration — C-fallback: gate 路由不可行(ScopeMask)整体回退 root-scope；清零归 D₂.2b（group-frame-d2.md §8.10 登记表）
diagram {
    profile: architecture,
    title: "drawify-core 模块依赖图"

  // ── 第 0 层：叶子基础 ─────────────────────────────────────
    group l0 {
        label: "L0 基础（几乎不依赖业务 mod）"
        node ast "ast"
        node error "error"
        node types "types\ndiagram_type · standard_attr_keys · style_attr_keys · style_attrs"
    }

  // ── 第 1 层：契约 ─────────────────────────────────────────
    group l1 {
        label: "L1 契约"
        node profile "profile\nDiagramProfile · profile_for"
    }

  // ── 第 2 层：主题数据 + 选择策略 ─────────────────────────
    group l2 {
        label: "L2 主题 theme"
        node theme_data "theme/\nbuiltin · loader · resolve · cascade"
        node theme_select "theme/select\nThemeIdResolver"
    }

  // ── 第 3 层：解析与预处理 ─────────────────────────────────
    group l3 {
        label: "L3 解析 / 预处理"
        node dsl "dsl\nlexer · parser"
        node prepare "prepare\nprofile_defaults · styles"
        node validation "validation\nattrs · common"
        node layout "layout\n算法 · 路由"
    }

  // ── 第 4 层：图表行为实现 ─────────────────────────────────
    group l4 {
        label: "L4 图表种类 kinds"
        node dt_registry "registry\nvalidate + scene 分派"
        node dt_flowchart "flowchart\nvalidate"
        node dt_arch "architecture\nvalidate"
        node dt_other "sequence · state\ner/semantics · mindmap\nmindmap_theme"
    }

  // ── 第 5 层：渲染与导出 ───────────────────────────────────
    group l5 {
        label: "L5 渲染管线"
        node graphic_style "graphic_style\n笔触皮肤"
        node render "render\nscene · paint · encode\nRenderRequest"
    }

  // ── 第 6 层：对外入口 ─────────────────────────────────────
    group l6 {
        label: "L6 入口"
        node pipeline "pipeline\nparse · prepare"
        node facade "facade"
    }

  // ── 反例：若 ENTITY_TYPES 放进 kinds 会成环 ───────
    group anti {
        label: "❌ 禁止的依赖（会 mod 循环）"
        node bad_registry "profile\n想 use kinds::flowchart"
        node bad_flowchart "kinds/flowchart\nvalidate 已 use layout"
    }

  // L0 内部
    ast -> types
    profile -> types
    ast -> dsl
    error -> validation

  // theme
    profile -> theme_select
    theme_data -> prepare
    theme_select -> prepare
    theme_data -> render

  // dsl / pipeline
    dsl -> pipeline
    ast -> pipeline

  // prepare / validation 读契约
    profile -> prepare
    profile -> validation
    layout -> validation
    dt_other -> prepare "mindmap_theme"

  // kinds 读 profile（单向！）
    profile -> dt_flowchart
    profile -> dt_arch
    layout -> dt_other "er/semantics 节点尺寸"
    dt_registry -> dt_flowchart
    dt_registry -> dt_arch
    dt_registry -> dt_other
    render -> dt_registry "scene_svg 分派"

  // 渲染链
    layout -> render
    graphic_style -> render
    prepare -> pipeline
    validation -> pipeline
    pipeline -> facade
    render -> facade

  // 反例环：registry → flowchart → spec → registry
    bad_registry -> bad_flowchart "若搬 ENTITY_TYPES 到这里"
    bad_flowchart --> bad_registry "render 调用 profile_for"
}
