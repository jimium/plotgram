// Blue-green deployment topology for a large production service
// Mermaid mapping: complex architecture graph for release traffic switching
// d2-exempt: group-penetration — C-fallback: gate 路由不可行(ScopeMask)整体回退 root-scope；清零归 D₂.2b（group-frame-d2.md §8.10 登记表）
diagram {
    profile: architecture,
    title: "K8s 蓝绿发布拓扑"

    group edge {
        label: "入口流量"
        node dns { label: "DNS", archetype: external }
        node cdn { label: "CDN", archetype: external }
        node waf { label: "WAF", archetype: gateway }
        node ingress { label: "Ingress Gateway", archetype: gateway }
    }

    group blue_env {
        label: "Blue 生产环境"
        node blue_gateway { label: "gateway-blue x8", archetype: service }
        node blue_checkout { label: "checkout-blue x12", archetype: service }
        node blue_payment { label: "payment-blue x10", archetype: service }
        node blue_worker { label: "worker-blue x16", archetype: service }
    }

    group green_env {
        label: "Green 候选环境"
        node green_gateway { label: "gateway-green x8", archetype: service }
        node green_checkout { label: "checkout-green x12", archetype: service }
        node green_payment { label: "payment-green x10", archetype: service }
        node green_worker { label: "worker-green x16", archetype: service }
    }

    group control_plane {
        label: "发布控制面"
        node argo_rollouts { label: "Argo Rollouts", archetype: service }
        node metrics { label: "Prometheus", archetype: service }
        node logs { label: "Loki", archetype: service }
        node feature_flag { label: "Feature Flag Service", archetype: service }
    }

    group shared_backend {
        label: "共享后端"
        node postgres { label: "PostgreSQL", archetype: database }
        node redis { label: "Redis", archetype: cache }
        node kafka { label: "Kafka", archetype: queue }
    }

    dns -> cdn
    cdn -> waf
    waf -> ingress
    ingress -> blue_gateway "90% traffic"
    ingress -> green_gateway "10% traffic"

    blue_gateway -> blue_checkout
    blue_checkout -> blue_payment
    blue_checkout -> blue_worker "async events"

    green_gateway -> green_checkout
    green_checkout -> green_payment
    green_checkout -> green_worker "async events"

    blue_checkout -> postgres
    blue_payment -> postgres
    blue_gateway -> redis
    blue_worker -> kafka

    green_checkout -> postgres
    green_payment -> postgres
    green_gateway -> redis
    green_worker -> kafka

    argo_rollouts -> ingress "shift traffic"
    argo_rollouts -> green_gateway "promote"
    argo_rollouts -> blue_gateway "scale down"
    green_checkout -> metrics
    green_payment -> metrics
    green_checkout -> logs
    green_payment -> logs
    metrics -> argo_rollouts "health signal"
    logs -> argo_rollouts "error signal"
    feature_flag -> green_checkout
    feature_flag -> blue_checkout
}
