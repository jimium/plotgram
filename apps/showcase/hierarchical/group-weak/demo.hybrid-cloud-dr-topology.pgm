// Hybrid cloud disaster recovery topology across on-prem and public cloud
// Mermaid mapping: complex architecture graph for compliance and DR planning
// d2-exempt: group-penetration — C-lane: gate 启用但基片轨道无外框避让；清零归 D₂.2b 基片 blocked region（group-frame-d2.md §8.10 登记表）
diagram {
    profile: architecture,
    title: "混合云灾备拓扑"

    group internet {
        label: "互联网入口"
        node dns { label: "Authoritative DNS", archetype: external }
        node traffic_mgr { label: "Traffic Manager", archetype: gateway }
        node waf { label: "WAF", archetype: gateway }
    }

    group primary_dc {
        label: "主数据中心"
        node primary_ingress { label: "Primary Ingress", archetype: gateway }
        node primary_app { label: "core-app x16", archetype: service }
        node primary_risk { label: "risk-engine x10", archetype: service }
        node primary_batch { label: "settlement-batch x8", archetype: service }
        node primary_db { label: "Primary Oracle", archetype: database }
    }

    group dr_cloud {
        label: "公有云灾备"
        node dr_ingress { label: "DR Ingress", archetype: gateway }
        node dr_app { label: "core-app-dr x8", archetype: service }
        node dr_risk { label: "risk-engine-dr x6", archetype: service }
        node dr_batch { label: "settlement-batch-dr x4", archetype: service }
        node dr_db { label: "DR PostgreSQL", archetype: database }
    }

    group governance {
        label: "治理与合规"
        node iam { label: "Central IAM", archetype: service }
        node cmdb { label: "CMDB", archetype: service }
        node audit { label: "Audit Archive", archetype: storage }
        node observability { label: "Unified Observability", archetype: service }
    }

    dns -> traffic_mgr
    traffic_mgr -> waf
    waf -> primary_ingress "primary route"
    waf -> dr_ingress "dr failover"

    primary_ingress -> primary_app
    primary_app -> primary_risk
    primary_app -> primary_batch
    primary_app -> primary_db
    primary_risk -> primary_db

    dr_ingress -> dr_app
    dr_app -> dr_risk
    dr_app -> dr_batch
    dr_app -> dr_db
    dr_risk -> dr_db

    iam -> primary_app
    iam -> dr_app
    cmdb -> primary_app "inventory sync"
    cmdb -> dr_app "inventory sync"
    primary_app -> observability
    dr_app -> observability
    primary_batch -> audit "daily evidence"
    dr_batch -> audit "dr evidence"

    primary_db --> dr_db "async replication"
    primary_app --> dr_app "configuration sync"
}
