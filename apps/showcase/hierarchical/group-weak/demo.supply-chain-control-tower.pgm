// Supply chain control tower spanning planning, fulfillment, logistics, and visibility
// Mermaid mapping: complex architecture graph for cross-enterprise supply chain coordination
// d2-exempt: group-penetration — C-lane: 绕行 Cross 的 Y 仍落在兄弟组像素框内（层缝与框重叠）
diagram {
    profile: architecture,
    title: "供应链控制塔"

    group upstream {
        label: "上游与计划"
        node supplier { label: "Supplier Portal", archetype: external }
        node procurement { label: "Procurement Service", archetype: service }
        node planning { label: "Demand Planning", archetype: service }
        node forecast { label: "Forecast Engine", archetype: service }
    }

    group operations {
        label: "运营与履约"
        node order_mgmt { label: "Order Management", archetype: service }
        node inventory { label: "Inventory Service", archetype: service }
        node warehouse_ops { label: "Warehouse Operations", archetype: service }
        node allocation { label: "Allocation Engine", archetype: service }
    }

    group logistics {
        label: "物流协同"
        node carrier { label: "Carrier Network", archetype: external }
        node shipment { label: "Shipment Service", archetype: service }
        node tracking { label: "Tracking Hub", archetype: service }
        node eta { label: "ETA Predictor", archetype: service }
    }

    group visibility {
        label: "控制塔能力"
        node event_bus { label: "Supply Event Bus", archetype: queue }
        node control_tower { label: "Control Tower UI", archetype: frontend }
        node alerting { label: "Alerting Engine", archetype: service }
        node analytics { label: "Operations Analytics", archetype: database }
    }

    supplier -> procurement
    procurement -> planning
    planning -> forecast
    forecast -> order_mgmt "replenishment plan"
    order_mgmt -> allocation
    allocation -> inventory
    inventory -> warehouse_ops
    warehouse_ops -> shipment "release shipment"
    shipment -> carrier
    carrier --> tracking "tracking updates"
    tracking -> eta
    procurement -> event_bus "po events"
    order_mgmt -> event_bus "fulfillment events"
    tracking -> event_bus "logistics events"
    event_bus -> alerting
    event_bus -> analytics
    analytics -> control_tower
    alerting -> control_tower
}
