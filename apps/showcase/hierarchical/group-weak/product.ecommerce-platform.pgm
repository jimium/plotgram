// 电商平台全栈架构：多层分组 + 外部依赖
// Mermaid 对照: 复杂 subgraph 嵌套架构图
diagram {
    profile: architecture,
    title: "电商平台架构"

    group client_layer {
        label: "接入层"
        node web { label: "Web 商城", archetype: frontend }
        node app { label: "移动 App", archetype: frontend }
        node admin { label: "运营后台", archetype: frontend }
    }

    group gateway_layer {
        label: "网关层"
        node cdn { label: "CDN", archetype: external }
        node lb { label: "负载均衡", archetype: gateway }
        node api_gw { label: "API 网关", archetype: gateway }

        cdn -> lb
        lb -> api_gw
    }

    group service_layer {
        label: "业务服务"
        node user_svc { label: "用户服务", archetype: service }
        node product_svc { label: "商品服务", archetype: service }
        node order_svc { label: "订单服务", archetype: service }
        node payment_svc { label: "支付服务", archetype: service }
        node search_svc { label: "搜索服务", archetype: service }
        node notify_svc { label: "通知服务", archetype: service }

        order_svc -> payment_svc
    }

    group data_layer {
        label: "数据层"
        node mysql { label: "MySQL 集群", archetype: database,
            meta.semantic: mysql
        }
        node redis { label: "Redis 缓存", archetype: cache,
            meta.semantic: redis
        }
        node es { label: "Elasticsearch", archetype: database,
            meta.semantic: elasticsearch
        }
        node mq { label: "RabbitMQ", archetype: queue,
            meta.semantic: rabbitmq
        }
    }

    group external {
        label: "外部系统"
        node alipay { label: "支付宝", archetype: external }
        node sms { label: "短信网关", archetype: external }
    }

    web -> cdn
    app -> lb
    admin -> api_gw
    api_gw -> user_svc
    api_gw -> product_svc
    api_gw -> order_svc
    api_gw -> search_svc
    payment_svc -> alipay
    user_svc -> mysql
    product_svc -> mysql
    order_svc -> mysql
    order_svc -> redis
    search_svc -> es
    order_svc -> mq "订单事件"
    mq --> notify_svc "异步通知"
    notify_svc -> sms
}
