// 可见合流：靠 auto_edge_grouping（端总线），不是 bus_routing
// orch 扇出三条边 → SharedPort → Trunk → Bus → Stub（Metric bus_y）
// bus_routing 仍打开，但跨层汇入边通常仍写不出 SharedCorridor（见 demo.bus_routing 注释）
diagram {
    profile: flowchart,
    title: "端总线合流（auto_edge_grouping）",
    layout: hierarchical { auto_edge_grouping: true, bus_routing: true }

    node orch { label: "编排器", archetype: process }
    node pay { label: "支付", archetype: service }
    node inv { label: "库存", archetype: service }
    node ship { label: "物流", archetype: service }
    node sink { label: "对账汇聚", archetype: process }

    orch -> pay
    orch -> inv
    orch -> ship
    pay -> sink
    inv -> sink
    ship -> sink
}
