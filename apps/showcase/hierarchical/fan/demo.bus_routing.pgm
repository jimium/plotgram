// bus_routing 探针（当前实现下多为 no-op）
//
// 实测（debug-layout ON vs OFF）：本图 5 条边 ChannelPath 开/关完全一致。
// 长边 west→store / east→store 的 track 序列形如 [Cross, Main_L, Cross]
// 与 [Cross, Main_R, Cross]——只共享末段 Cross，后缀长度 = 1；
// detect_corridor_bundles 要求 min_suffix ≥ 2，故写不出 SharedCorridor。
// 图中末段看似共水平轨，来自 TrackOrder 在同一 Cross track 上的分轨/同轨，
// 不是 BundlePlan。
//
// 可见的「总线」请看 auto_edge_grouping.pgm（端总线 SharedPort→Trunk→Bus→Stub）。
diagram {
    profile: flowchart,
    title: "bus_routing 探针（当前无 SharedCorridor）",
    layout: hierarchical { auto_edge_grouping: false, bus_routing: true }

    node west { label: "西区接入", archetype: process }
    node east { label: "东区接入", archetype: process }
    node core { label: "核心交换", archetype: process }
    node store { label: "统一落库", archetype: storage }

    west -> store
    east -> store
    west -> core
    east -> core
    core -> store
}
