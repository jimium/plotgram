// bus_routing — Channel 长程走廊合流（edge-parameters §2.4）
// 两条跨多层边汇入同一汇点：共享 ChannelPath 后缀 → BundlePlan SharedCorridor；
// TrackOrder 在共享 track 上强制同轨；Ink Verifier 允许故意共线。
// 对照：关 bus_routing 时同拓扑会分轨（无 SharedCorridor）。
diagram {
    profile: flowchart,
    title: "Channel 走廊合流（bus_routing）",
    layout: hierarchical { auto_edge_grouping: false, bus_routing: true }

    node west { label: "西区接入", archetype: process }
    node east { label: "东区接入", archetype: process }
    node core { label: "核心交换", archetype: process }
    node store { label: "统一落库", archetype: storage }

    // 跨两层长边：Channel 走 Cross→Main→Cross…，近汇点易共享后缀轨
    west -> store
    east -> store
    west -> core
    east -> core
    core -> store
}
