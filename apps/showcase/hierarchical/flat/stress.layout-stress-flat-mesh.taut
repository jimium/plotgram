// Layout Stress: Flat Mesh（无 group）
// 算法探针：单层高密度交叉边——多服务共享缓存/库/队列，验正交路由避障与确定性。
// 对照：stress.layout-stress-nested.taut（深度嵌套 group）
diagram {
    profile: architecture,
    title: "布局测试：无分组高密度网状拓扑"
node client { label: "客户端", archetype: frontend }
    node gateway { label: "API 网关", archetype: gateway }
    node auth { label: "认证服务", archetype: service }
    node catalog { label: "商品服务", archetype: service }
    node cart { label: "购物车服务", archetype: service }
    node order { label: "订单服务", archetype: service }
    node notify { label: "通知服务", archetype: service }
    node redis { label: "Redis", archetype: cache }
    node pg { label: "PostgreSQL", archetype: database }
    node kafka { label: "Kafka", archetype: queue }
    node sms { label: "短信网关", archetype: external }

    client -> gateway "HTTPS"
    gateway -> auth
    gateway -> catalog
    gateway -> cart
    gateway -> order

    auth -> redis "会话"
    catalog -> redis "热点缓存"
    cart -> redis "购物车缓存"
    order -> redis "幂等键"

    catalog -> pg "读写商品"
    cart -> pg "读写购物车"
    order -> pg "读写订单"
    auth -> pg "读写用户"

    order -> kafka "order.created"
    cart -> kafka "cart.updated"
    kafka -> notify "消费事件"
    notify -> sms "下发短信"

    // 交叉回流：打穿扇出层，逼出单层绕障
    notify --> order "送达回执"
    catalog --> order "库存预留"
    order --> catalog "扣减库存"
}
