// 客服工单分派流程：接单 → 分类 → 分派 → 关单
// 业务场景: 客服系统工单自动分类与优先级路由
// Mermaid 对照: graph TD + 优先级分支
diagram {
    profile: flowchart,
    title: "客服工单分派流程",
    layout: hierarchical { direction: top-to-bottom }

    node create { label: "用户提交工单", archetype: start }
    node classify { label: "自动分类", archetype: process }
    node type_gate { label: "工单类型？", archetype: decision }
    node tech_team { label: "技术支持组", archetype: process }
    node billing_team { label: "账务处理组", archetype: process }
    node general_team { label: "综合客服组", archetype: process }
    node handle { label: "客服处理", archetype: process }
    node resolve_gate { label: "是否解决？", archetype: decision }
    node escalate { label: "升级到二线", archetype: process }
    node close { label: "关闭工单", archetype: end }

    create -> classify
    classify -> type_gate
    type_gate -> tech_team "技术问题"
    type_gate -> billing_team "账单问题"
    type_gate -> general_team "其他咨询"
    tech_team -> handle
    billing_team -> handle
    general_team -> handle
    handle -> resolve_gate
    resolve_gate -> close "已解决"
    resolve_gate -> escalate "未解决"
    escalate -> handle "二线接手"
}
