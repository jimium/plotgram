// 密码重置流程：验证身份 → 发送链接 → 重设密码
// 业务场景: 账户中心的忘记密码自助重置，含邮箱验证与失败重试
// Mermaid 对照: graph TD + 校验分支与回环
diagram {
    profile: flowchart,
    title: "密码重置流程",
    layout: hierarchical { direction: top-to-bottom }

    node start { label: "点击忘记密码", archetype: start }
    node input_email { label: "输入注册邮箱", archetype: process }
    node email_gate { label: "邮箱是否存在？", archetype: decision }
    node send_link { label: "发送重置链接", archetype: process }
    node click_link { label: "用户点击链接", archetype: process }
    node token_gate { label: "链接是否有效？", archetype: decision }
    node set_new { label: "设置新密码", archetype: process }
    node update_db { label: "更新密码库", archetype: database }
    node show_error { label: "提示邮箱未注册", archetype: process }
    node done { label: "重置成功", archetype: end }

    start -> input_email
    input_email -> email_gate
    email_gate -> send_link "存在"
    email_gate -> show_error "不存在"
    show_error -> input_email "重新输入"
    send_link -> click_link
    click_link -> token_gate
    token_gate -> set_new "有效"
    token_gate -> send_link "过期，重发"
    set_new -> update_db
    update_db -> done
}
