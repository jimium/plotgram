// Change approval workflow for regulated production releases
// Mermaid mapping: complex approval flowchart with audit and rollback gates
diagram {
    profile: flowchart,
    title: "生产变更审批流程",
    layout: hierarchical { direction: top-to-bottom }

    node request { label: "提交变更申请", archetype: start }
    node classify { label: "识别变更类型", archetype: process }
    node risk_gate { label: "高风险变更？", archetype: decision }
    node impact { label: "补充影响评估", archetype: process }
    node test_evidence { label: "附加测试证据", archetype: process }
    node security_review { label: "安全评审", archetype: process }
    node arch_review { label: "架构评审", archetype: process }
    node cab_gate { label: "CAB 审批通过？", archetype: decision }
    node schedule { label: "安排变更窗口", archetype: process }
    node deploy { label: "执行生产发布", archetype: process }
    node verify { label: "发布后验证", archetype: process }
    node verify_gate { label: "验证通过？", archetype: decision }
    node rollback { label: "执行回滚", archetype: process }
    node archive { label: "归档审计材料", archetype: process }
    node reject { label: "驳回并补充材料", archetype: process }
    node done { label: "变更完成", archetype: end }

    request -> classify
    classify -> risk_gate
    risk_gate -> impact "是"
    risk_gate -> test_evidence "否"
    impact -> test_evidence
    test_evidence -> security_review
    security_review -> arch_review
    arch_review -> cab_gate
    cab_gate -> schedule "是"
    cab_gate -> reject "否"
    reject -> request "补充后重提"
    schedule -> deploy
    deploy -> verify
    verify -> verify_gate
    verify_gate -> archive "是"
    verify_gate -> rollback "否"
    rollback -> archive
    archive -> done
}
