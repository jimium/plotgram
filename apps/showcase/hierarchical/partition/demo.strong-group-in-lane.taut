// PG-4: StrongMacro group nested inside a single partition column.
// Global bands are Fit envelopes after expand (no second VPSC).
diagram {
    profile: flowchart,
    title: "组嵌套在泳道内（StrongMacro）",
    layout: hierarchical { direction: top-to-bottom, group_policy: strong-macro }

    partition {
        column sales { label: "销售" }
        column warehouse { label: "仓储" }
    }

    group review {
        label: "审核"
        node check { label: "核对", archetype: process, cell_col: sales }
        node approve { label: "批准", archetype: process, cell_col: sales }
    }

    node pick { label: "拣货", archetype: process, cell_col: warehouse }
    node ship { label: "发运", archetype: end, cell_col: warehouse }

    check -> approve
    approve -> pick
    pick -> ship
}
