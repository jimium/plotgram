# Tautcore Agent API — 环境变量配置
#
# 复制为 .env 并填入真实值：
#   cp .env.example .env && vim .env

# ─── DeepSeek ───────────────────────────────────────────
# DeepSeek API Key（必填，否则 /agent/chat 返回 upstream_error）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek 接口地址（默认官方，无 /v1 后缀）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型（deepseek-chat 2026/07/24 弃用，迁移到 deepseek-v4-flash）
# 可选：deepseek-v4-flash（便宜）/ deepseek-v4-pro（强但贵）
DEEPSEEK_MODEL=deepseek-v4-flash

# ─── 演示开关 ───────────────────────────────────────────
# 一键关闭演示（L7 防滥用），关闭后 /agent/chat 返回 demo_disabled
DEMO_ENABLED=true

# 允许的 Origin（逗号分隔），L1 CORS 校验
# 生产环境填前端实际域名
DEMO_ALLOWED_ORIGINS=https://demo.plotgram.dev,https://plotgram.cn,https://www.plotgram.cn,https://assets.pg.agcli.cn,https://api.pg.agcli.cn,https://assets.plotgram.cn,https://api.plotgram.cn

# ─── 防滥用配额 ─────────────────────────────────────────
# 全局 token 总额度池（所有 session 共享）
# DEMO_TOTAL_TOKEN_BUDGET=2000000

# 单 session token 上限
# DEMO_PER_SESSION_TOKEN_BUDGET=30000

# 单 session 请求次数上限（Agent 多轮 tool calling，需放宽）
DEMO_PER_SESSION_REQUEST_LIMIT=100

# 单次请求最大 token 数
# DEMO_MAX_TOKENS_PER_REQUEST=4096

# 请求体最大字节数
# DEMO_MAX_MESSAGES_BYTES=65536

# IP 限流：每分钟请求数（Agent 单次对话可能触发 3-6 轮 LLM 调用，需放宽）
DEMO_RATE_LIMIT_PER_MINUTE=200

# IP 限流：突发容量
DEMO_RATE_LIMIT_BURST=30

# ─── 服务监听 ───────────────────────────────────────────
# 绑定地址（生产环境必须为 127.0.0.1，由 nginx 反代）
TAUTCORE_SERVER_ADDR=127.0.0.1:6080
