// 无 group 冒烟：网关扇出到双服务再汇入存储
// 用途：覆盖单层布局的 fan-out / fan-in，对照有 group 路径
// @role: smoke  (authoritative: filename prefix)
diagram architecture {
    title: "无分组：网关扇出"

    entity[gateway] gw "网关"
    entity[service] a "服务 A"
    entity[service] b "服务 B"
    entity[database] db "数据库" {
        semantic: postgres
    }

    gw -> a
    gw -> b
    a -> db
    b -> db
}
