// REST API 后端分层架构：接入层 + 业务层 + 数据层
// 业务场景: 典型单体 REST 后端服务的分层拓扑
// Mermaid 对照: graph + subgraph 分层
// @role: product  (authoritative: filename prefix)
diagram architecture {
    title: "REST API 后端分层架构"
    layout: architecture
    edge_routing: orthogonal
    theme: common.clean-light

    group edge "接入层" {
        entity[frontend] web "Web 客户端" {
            semantic: browser
        }
        entity[gateway] lb "负载均衡" {
            semantic: nginx
        }
    }

    group app "业务层" {
        entity[service] api "REST API 服务"
        entity[service] auth "认证鉴权"
        entity[service] biz "业务逻辑服务"
    }

    group data "数据层" {
        entity[database] db "MySQL" {
            semantic: mysql
        }
        entity[cache] redis "Redis 缓存" {
            semantic: redis
        }
    }

    web -> lb "HTTPS"
    lb -> api "反向代理"
    api -> auth "鉴权校验"
    api -> biz "调用业务"
    biz -> db "读写数据"
    biz -> redis "读写缓存"
    auth -> redis "会话存储"
}
