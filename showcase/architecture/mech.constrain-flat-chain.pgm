// architecture 无 group constrain：强制 metrics 在 db 下游
// 对照：mech.constrain-cross-group.pgm（跨组 constrain）
// @role: mech  (authoritative: filename prefix)
diagram architecture {
    title: "constrain flat-chain"

    entity[gateway] gw "Gateway"
    entity[service] api "API"
    entity[service] worker "Worker"
    entity[database] db "DB"
    entity[external] metrics "Metrics"

    gw -> api
    api -> worker
    worker -> db
    // 业务边从 worker 旁路上报；仅靠它不足以保证 metrics 在 db 下游
    worker --> metrics "上报"

    // 隐形硬约束：即使旁路边稀疏，也强制 metrics 在 db 下游
    constrain db -> metrics
}
