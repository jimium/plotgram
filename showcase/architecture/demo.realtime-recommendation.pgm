// 实时推荐系统架构：埋点 → 特征 → 召回 → 排序 → 下发
// 业务场景: 电商/内容平台的实时个性化推荐系统拓扑
// Mermaid 对照: 复杂 graph + 多 subgraph 推荐链路
// @role: demo  (authoritative: filename prefix)
diagram architecture {
    title: "实时推荐系统架构"
    layout: architecture
    edge_routing: orthogonal
    theme: common.clean-light

    group client "客户端" {
        entity[frontend] app "移动 App" {
            semantic: mobile
        }
    }

    group stream "实时数据" {
        entity[queue] event_bus "行为事件流" {
            semantic: kafka
        }
        entity[service] feature "特征计算" {
            semantic: flink
        }
        entity[cache] feature_store "特征存储" {
            semantic: redis
        }
    }

    group engine "推荐引擎" {
        entity[service] recall "召回服务"
        entity[service] rank "排序服务"
        entity[service] rerank "重排与打散"
    }

    group model "模型与存储" {
        entity[storage] model_store "模型仓库"
        entity[database] item_db "物料库" {
            semantic: mongodb
        }
    }

    app -> event_bus "上报行为"
    event_bus -> feature "实时计算"
    feature -> feature_store "写特征"
    app -> recall "请求推荐"
    recall -> item_db "候选物料"
    recall -> feature_store "读特征"
    recall -> rank "候选集"
    rank -> model_store "加载模型"
    rank -> rerank "排序结果"
    rerank -> app "下发推荐列表"
}
