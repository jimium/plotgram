// 金融支付平台架构：收单 → 路由 → 清算 → 对账
// 业务场景: 聚合支付平台的收单、渠道路由、清结算与风控拓扑
// Mermaid 对照: 复杂 graph + 多 subgraph 支付平台
// @role: demo  (authoritative: filename prefix)
diagram architecture {
    title: "金融支付平台架构"
    layout: architecture
theme: common.clean-light

    group access "商户接入" {
        entity[frontend] merchant "商户系统"
        entity[gateway] pay_gw "支付网关"
    }

    group core "支付核心" {
        entity[service] cashier "收银服务"
        entity[service] router "渠道路由"
        entity[service] risk "风控引擎"
        entity[service] account "账户服务"
    }

    group channel "支付渠道" {
        entity[external] bank "银行网联"
        entity[external] wallet "第三方钱包"
    }

    group settle "清结算" {
        entity[service] clearing "清算服务"
        entity[service] recon "对账服务"
        entity[database] ledger "记账库" {
            semantic: postgres
        }
    }

    merchant -> pay_gw "发起支付"
    pay_gw -> cashier "创建交易"
    cashier -> risk "风险评估"
    risk --> cashier "风控通过"
    cashier -> router "选择渠道"
    router -> bank "银行支付"
    router -> wallet "钱包支付"
    cashier -> account "记账"
    account -> ledger "写流水"
    bank --> clearing "清算文件"
    wallet --> clearing "清算文件"
    clearing -> ledger "生成清算分录"
    clearing -> recon "对账"
    recon --> merchant "对账结果"
}
