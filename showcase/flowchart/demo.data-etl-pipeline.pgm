// 数据 ETL 流水线：抽取 → 清洗 → 转换 → 加载 → 校验
// 业务场景: 数据仓库离线 ETL 作业调度，含质量校验与失败重跑
// Mermaid 对照: 复杂 graph TD，含 group 分段与质量门禁
// @role: demo  (authoritative: filename prefix)
diagram flowchart {
    title: "数据 ETL 流水线"
    config {
        direction: top-to-bottom
    }

    group extract "抽取阶段" {
        entity[start] trigger "调度触发"
        entity[database] source "业务库"
        entity[process] pull "全量/增量抽取"
    }

    group transform_stage "转换阶段" {
        entity[process] clean "数据清洗"
        entity[process] dedup "去重"
        entity[process] transform "字段映射转换"
        entity[decision] quality_gate "质量校验通过？"
        entity[process] quarantine "隔离脏数据"
    }

    group load_stage "加载阶段" {
        entity[storage] dwh "数据仓库"
        entity[process] load "写入维度/事实表"
        entity[process] build_mart "构建数据集市"
        entity[process] alert "告警通知"
        entity[end] done "作业成功"
    }

    trigger -> pull
    source -> pull "读取"
    pull -> clean
    clean -> dedup
    dedup -> transform
    transform -> quality_gate
    quality_gate -> load "通过"
    quality_gate -> quarantine "不通过"
    quarantine -> alert
    alert -> clean "修复后重跑"
    load -> dwh "落库"
    load -> build_mart
    build_mart -> done
}
