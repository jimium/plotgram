// 事故管理流程：告警 → 定级 → 响应 → 恢复 → 复盘
// 业务场景: SRE 生产事故（Incident）响应闭环，含分级与升级
// Mermaid 对照: 复杂 graph TD，含 group 分段与升级回环
// @role: demo  (authoritative: filename prefix)
diagram flowchart {
    title: "生产事故管理流程"
    config {
        direction: top-to-bottom
    }

    group detect "发现与定级" {
        entity[start] alert "监控告警触发"
        entity[process] ack "值班确认"
        entity[decision] severity_gate "事故等级？"
        entity[process] p1_war_room "P1 应急作战室"
        entity[process] p2_handle "P2 常规响应"
    }

    group response "响应处置" {
        entity[process] mitigate "止血缓解"
        entity[decision] mitigate_gate "是否恢复？"
        entity[process] escalate "升级专家团队"
        entity[process] rollback "回滚变更"
        entity[process] recover "服务恢复"
    }

    group review "复盘改进" {
        entity[process] postmortem "事故复盘"
        entity[process] action "改进项跟踪"
        entity[end] closed "事故关闭"
    }

    alert -> ack
    ack -> severity_gate
    severity_gate -> p1_war_room "P1"
    severity_gate -> p2_handle "P2/P3"
    p1_war_room -> mitigate
    p2_handle -> mitigate
    mitigate -> mitigate_gate
    mitigate_gate -> recover "已恢复"
    mitigate_gate -> escalate "未恢复"
    escalate -> rollback
    rollback -> mitigate "再次尝试"
    recover -> postmortem
    postmortem -> action
    action -> closed
}
