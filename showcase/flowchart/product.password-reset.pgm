// 密码重置流程：验证身份 → 发送链接 → 重设密码
// 业务场景: 账户中心的忘记密码自助重置，含邮箱验证与失败重试
// Mermaid 对照: graph TD + 校验分支与回环
// @role: product  (authoritative: filename prefix)
diagram flowchart {
    title: "密码重置流程"
    config {
        direction: top-to-bottom
    }

    entity[start] start "点击忘记密码"
    entity[process] input_email "输入注册邮箱"
    entity[decision] email_gate "邮箱是否存在？"
    entity[process] send_link "发送重置链接"
    entity[process] click_link "用户点击链接"
    entity[decision] token_gate "链接是否有效？"
    entity[process] set_new "设置新密码"
    entity[database] update_db "更新密码库"
    entity[process] show_error "提示邮箱未注册"
    entity[end] done "重置成功"

    start -> input_email
    input_email -> email_gate
    email_gate -> send_link "存在"
    email_gate -> show_error "不存在"
    show_error -> input_email "重新输入"
    send_link -> click_link
    click_link -> token_gate
    token_gate -> set_new "有效"
    token_gate -> send_link "过期，重发"
    set_new -> update_db
    update_db -> done
}
