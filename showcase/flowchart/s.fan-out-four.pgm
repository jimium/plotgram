// 四路同源扇出：验证 flowchart trunk+fork 与 slot 汇流
diagram flowchart {
    title: "四路同源扇出"
    config {
        direction: left-to-right
        edge_routing: orthogonal
    }

    entity[process] hub "API 网关"
    entity[process] svc_a "用户服务"
    entity[process] svc_b "订单服务"
    entity[process] svc_c "支付服务"
    entity[process] svc_d "通知服务"

    hub -> svc_a
    hub -> svc_b
    hub -> svc_c
    hub -> svc_d
}
