// 客服工单分派流程：接单 → 分类 → 分派 → 关单
// 业务场景: 客服系统工单自动分类与优先级路由
// Mermaid 对照: graph TD + 优先级分支
// @role: product  (authoritative: filename prefix)
diagram flowchart {
    title: "客服工单分派流程"
    config {
        direction: top-to-bottom
    }

    entity[start] create "用户提交工单"
    entity[process] classify "自动分类"
    entity[decision] type_gate "工单类型？"
    entity[process] tech_team "技术支持组"
    entity[process] billing_team "账务处理组"
    entity[process] general_team "综合客服组"
    entity[process] handle "客服处理"
    entity[decision] resolve_gate "是否解决？"
    entity[process] escalate "升级到二线"
    entity[end] close "关闭工单"

    create -> classify
    classify -> type_gate
    type_gate -> tech_team "技术问题"
    type_gate -> billing_team "账单问题"
    type_gate -> general_team "其他咨询"
    tech_team -> handle
    billing_team -> handle
    general_team -> handle
    handle -> resolve_gate
    resolve_gate -> close "已解决"
    resolve_gate -> escalate "未解决"
    escalate -> handle "二线接手"
}
