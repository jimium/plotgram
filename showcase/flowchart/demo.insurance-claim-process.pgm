// 保险理赔流程：报案 → 定损 → 核赔 → 赔付
// 业务场景: 车险理赔端到端流程，含查勘定损与核赔分级
// Mermaid 对照: 复杂 graph TD，含 group 分段与拒赔回环
// @role: demo  (authoritative: filename prefix)
diagram flowchart {
    title: "保险理赔流程"
    config {
        direction: top-to-bottom
    }

    group report_stage "报案受理" {
        entity[start] report "客户报案"
        entity[process] register "登记案件"
        entity[decision] cover_gate "是否在保障范围？"
    }

    group survey_stage "查勘定损" {
        entity[process] dispatch "派遣查勘员"
        entity[process] survey "现场查勘"
        entity[process] assess "损失评估"
        entity[decision] amount_gate "损失金额？"
    }

    group settle "核赔理算" {
        entity[process] junior_audit "初级核赔"
        entity[process] senior_audit "高级核赔"
        entity[decision] audit_gate "核赔结论？"
        entity[process] pay "赔款支付"
        entity[end] closed "结案"
        entity[end] declined "拒赔"
    }

    report -> register
    register -> cover_gate
    cover_gate -> dispatch "承保"
    cover_gate -> declined "免责"

    dispatch -> survey
    survey -> assess
    assess -> amount_gate
    amount_gate -> junior_audit "小额"
    amount_gate -> senior_audit "大额"
    junior_audit -> audit_gate
    senior_audit -> audit_gate
    audit_gate -> pay "核准"
    audit_gate -> declined "拒赔"
    audit_gate -> survey "需复勘"

    pay -> closed
}
