// 费用报销流程：提交单据 → 财务审核 → 支付
// 业务场景: 企业费用报销，含金额阈值分级审批与票据驳回
// Mermaid 对照: graph TD + 多级审批分支
// @role: product  (authoritative: filename prefix)
diagram flowchart {
    title: "费用报销流程"
    config {
        direction: top-to-bottom
    }

    entity[start] start "发起报销"
    entity[process] upload "上传发票与单据"
    entity[decision] check_gate "票据是否齐全？"
    entity[process] finance_audit "财务初审"
    entity[decision] amount_gate "金额 > 5000？"
    entity[process] manager_approve "经理审批"
    entity[process] cfo_approve "财务总监审批"
    entity[process] pay "打款到账户"
    entity[end] done "报销完成"

    start -> upload
    upload -> check_gate
    check_gate -> finance_audit "齐全"
    check_gate -> upload "缺失，补充"
    finance_audit -> amount_gate
    amount_gate -> manager_approve "否"
    amount_gate -> cfo_approve "是"
    manager_approve -> pay
    cfo_approve -> pay
    pay -> done
}
