// 金融支付平台架构：收单 → 路由 → 清算 → 对账
// 业务场景: 聚合支付平台的收单、渠道路由、清结算与风控拓扑
// Mermaid 对照: 复杂 graph + 多 subgraph 支付平台
diagram {
    profile: architecture
    title: "金融支付平台架构"
    layout: architecture
theme: common.clean-light

    group access {
        label: "商户接入"
        node merchant { label: "商户系统", archetype: frontend }
        node pay_gw { label: "支付网关", archetype: gateway }
    }

    group core {
        label: "支付核心"
        node cashier { label: "收银服务", archetype: service }
        node router { label: "渠道路由", archetype: service }
        node risk { label: "风控引擎", archetype: service }
        node account { label: "账户服务", archetype: service }
    }

    group channel {
        label: "支付渠道"
        node bank { label: "银行网联", archetype: external }
        node wallet { label: "第三方钱包", archetype: external }
    }

    group settle {
        label: "清结算"
        node clearing { label: "清算服务", archetype: service }
        node recon { label: "对账服务", archetype: service }
        node ledger { label: "记账库", archetype: database
            meta.semantic: postgres
        }
    }

    merchant -> pay_gw "发起支付"
    pay_gw -> cashier "创建交易"
    cashier -> risk "风险评估"
    risk --> cashier "风控通过"
    cashier -> router "选择渠道"
    router -> bank "银行支付"
    router -> wallet "钱包支付"
    cashier -> account "记账"
    account -> ledger "写流水"
    bank --> clearing "清算文件"
    wallet --> clearing "清算文件"
    clearing -> ledger "生成清算分录"
    clearing -> recon "对账"
    recon --> merchant "对账结果"
}
