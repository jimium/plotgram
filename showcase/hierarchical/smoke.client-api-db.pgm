// 最简架构图：单向数据流
// Mermaid 对照: graph TD; User-->App-->DB
diagram {
    profile: architecture
    title: "单向数据流"

    node user { label: "用户", archetype: frontend
        meta.semantic: user
    }
    node app { label: "应用", archetype: service }
    node db { label: "数据存储", archetype: database
        meta.semantic: postgres
    }

    user -> app
    app -> db
}
