// 数据 ETL 流水线：抽取 → 清洗 → 转换 → 加载 → 校验
// 业务场景: 数据仓库离线 ETL 作业调度，含质量校验与失败重跑
// Mermaid 对照: 复杂 graph TD，含 group 分段与质量门禁
diagram {
    profile: flowchart
    title: "数据 ETL 流水线"
    layout: hierarchical { direction: top-to-bottom }

    group extract {
        label: "抽取阶段"
        node trigger { label: "调度触发", archetype: start }
        node source { label: "业务库", archetype: database }
        node pull { label: "全量/增量抽取", archetype: process }
    }

    group transform_stage {
        label: "转换阶段"
        node clean { label: "数据清洗", archetype: process }
        node dedup { label: "去重", archetype: process }
        node transform { label: "字段映射转换", archetype: process }
        node quality_gate { label: "质量校验通过？", archetype: decision }
        node quarantine { label: "隔离脏数据", archetype: process }
    }

    group load_stage {
        label: "加载阶段"
        node dwh { label: "数据仓库", archetype: storage }
        node load { label: "写入维度/事实表", archetype: process }
        node build_mart { label: "构建数据集市", archetype: process }
        node alert { label: "告警通知", archetype: process }
        node done { label: "作业成功", archetype: end }
    }

    trigger -> pull
    source -> pull "读取"
    pull -> clean
    clean -> dedup
    dedup -> transform
    transform -> quality_gate
    quality_gate -> load "通过"
    quality_gate -> quarantine "不通过"
    quarantine -> alert
    alert -> clean "修复后重跑"
    load -> dwh "落库"
    load -> build_mart
    build_mart -> done
}
