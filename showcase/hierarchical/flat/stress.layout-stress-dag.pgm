// Layout Stress: Complex DAG & Routing
// 算法探针：回环边、自环、跨层长边（美观可妥协；正确性/确定性仍硬盯）
diagram {
    profile: flowchart,
    title: "布局测试：复杂有向无环图与长边路由",
    layout: hierarchical { direction: top-to-bottom }

    node start { label: "启动", archetype: start }
    node n1 { label: "节点 1", archetype: process }
    node n2 { label: "节点 2", archetype: decision }
    node n3 { label: "节点 3", archetype: process }
    node n4 { label: "节点 4", archetype: decision }
    node n5 { label: "节点 5", archetype: decision }
    node n6 { label: "节点 6", archetype: process }
    node n7 { label: "节点 7", archetype: process }
    node n8 { label: "节点 8", archetype: decision }
    node n9 { label: "节点 9", archetype: decision }
    node end { label: "结束", archetype: end }

    start -> n1
    start -> n2 "旁路"
    n1 -> n2
    n2 -> n3 "条件 A"
    n2 -> n4 "条件 B"
    n3 -> n5
    n4 -> n5
    n5 -> n6 "通过"
    n5 -> n2 "重试 (回环边)"
    n6 -> n7
    n7 -> n8
    n8 -> n9 "确认"
    n8 -> n5 "打回 (回环边)"
    n9 -> end
    n9 -> n9 "等待异步 (自环)"
    
    // 测试跨层长边
    n1 -> end "快速通道 (跨多层)"
    n3 -> n7 "跳层边"
    
    // 测试节点自环
    n4 -> n4 "自检"
}
