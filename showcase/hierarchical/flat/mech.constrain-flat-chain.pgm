// architecture 无 group constrain：强制 metrics 在 db 下游
// 对照：mech.constrain-cross-group.pgm（跨组 constrain）
diagram {
    profile: architecture,
    title: "constrain flat-chain"

    node gw { label: "Gateway", archetype: gateway }
    node api { label: "API", archetype: service }
    node worker { label: "Worker", archetype: service }
    node db { label: "DB", archetype: database }
    node metrics { label: "Metrics", archetype: external }

    gw -> api
    api -> worker
    worker -> db
    // 业务边从 worker 旁路上报；仅靠它不足以保证 metrics 在 db 下游
    worker --> metrics "上报"

    // 隐形硬约束：即使旁路边稀疏，也强制 metrics 在 db 下游
    // constrain（旧语法，新规范暂无对应；保留注释）
    // constrain db -> metrics
}
