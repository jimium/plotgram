// 软件发布流水线：多阶段门禁 + 回滚路径
// Mermaid 对照: 复杂 CI/CD 流程图
diagram {
    profile: flowchart,
    title: "软件发布流水线",
    layout: hierarchical { direction: top-to-bottom }

    node commit { label: "代码提交", archetype: start }
    node build { label: "构建", archetype: process }
    node unit_test { label: "单元测试", archetype: process }
    node integration { label: "集成测试", archetype: process }
    node staging { label: "预发部署", archetype: process }
    node canary { label: "金丝雀发布", archetype: process }
    node prod { label: "全量上线", archetype: process }
    node rollback { label: "回滚", archetype: process }
    node done { label: "发布完成", archetype: end }
    node gate_build { label: "构建通过？", archetype: decision }
    node gate_test { label: "测试通过？", archetype: decision }
    node gate_staging { label: "预发验证？", archetype: decision }
    node gate_canary { label: "金丝雀健康？", archetype: decision }
    node notify { label: "通知开发修复", archetype: process }

    commit -> build
    build -> gate_build
    gate_build -> unit_test "是"
    gate_build -> notify "否"
    unit_test -> gate_test
    gate_test -> integration "是"
    gate_test -> notify "否"
    integration -> staging
    staging -> gate_staging
    gate_staging -> canary "是"
    gate_staging -> notify "否"
    canary -> gate_canary
    gate_canary -> prod "是"
    gate_canary -> rollback "否"
    prod -> done
    rollback -> notify
    notify -> commit "修复后重试"
}
