// 典型微服务架构：网关路由 + 数据/缓存/消息队列 + 监控上报
// Mermaid 对照: graph + 多服务拓扑与虚线监控边
diagram {
    profile: architecture,
  title: "典型微服务架构图",
  layout: hierarchical,
theme: common.clean-light,
  render_style: standard

  // ========== 实体声明 ==========
  node api_gateway { label: "API 网关", archetype: gateway,
    meta.semantic: gateway
  }

  node user_svc { label: "用户服务", archetype: service,
    meta.semantic: auth
  }

  node order_svc { label: "订单服务", archetype: service,
    meta.semantic: payment
  }

  node product_svc { label: "商品服务", archetype: service,
    meta.semantic: server
  }

  node redis { label: "Redis 缓存", archetype: cache,
    meta.semantic: redis
  }

  node postgres { label: "PostgreSQL", archetype: database,
    meta.semantic: postgres
  }

  node kafka { label: "Kafka 消息队列", archetype: queue,
    meta.semantic: kafka
  }

  node prometheus { label: "Prometheus 监控", archetype: external,
    meta.semantic: prometheus
  }

  // ========== 关系声明 ==========
  api_gateway -> user_svc "路由请求 /users"
  api_gateway -> order_svc "路由请求 /orders"
  api_gateway -> product_svc "路由请求 /products"

  user_svc -> postgres "读写用户数据"
  order_svc -> postgres "读写订单数据"
  product_svc -> postgres "读写商品数据"

  order_svc -> redis "缓存订单"
  product_svc -> redis "缓存商品"

  order_svc -> kafka "发送订单事件 order.created"
  user_svc -> kafka "发送用户事件 user.updated"

  user_svc --> prometheus "上报指标"
  order_svc --> prometheus "上报指标"
  product_svc --> prometheus "上报指标"
  redis --> prometheus "上报指标"
  postgres --> prometheus "上报指标"
  kafka --> prometheus "上报指标"
}
