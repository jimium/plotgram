// Layout Stress: yFiles 数据管道拓扑（仅图形结构）
//
// 来源：yFiles 官网/文档截图中的数据管道示例图（拓扑转写，节点语义已抽象）。
// 算法探针：23 节点 / 31 边 DAG；顶层四路扇出、bypass 长边、多路扇入汇聚、正交路由通道争用。
diagram {
    profile: flowchart,
    title: "布局测试：yFiles 数据管道拓扑",
    layout: hierarchical { direction: top-to-bottom }

    // ── 主干 ──
    node n0 { label: "入口", archetype: start }
    node n1 { label: "路由", archetype: process }
    node j1 { label: "·", archetype: process }          // 无标签小方块
    node n2 { label: "湖仓", archetype: process }
    node n3 { label: "API", archetype: process }
    node n_sink { label: "出口", archetype: end }

    // ── 路由三分支 ──
    node j2 { label: "·", archetype: process }
    node c1 { label: "·", archetype: process }          // 竖向胶囊 → flowchart 无独立形状，用 process 占位
    node n4 { label: "重试队列", archetype: process }

    // ── 左路：三路汇入去重 ──
    node n5 { label: "批处理", archetype: process }
    node j3 { label: "·", archetype: process }
    node n6 { label: "预取", archetype: process }
    node n7 { label: "源A", archetype: process }
    node c2 { label: "·", archetype: process }
    node j4 { label: "·", archetype: process }
    node n8 { label: "去重", archetype: process }

    // ── 右路：两路汇入发布 ──
    node j5 { label: "·", archetype: process }
    node n9 { label: "流处理", archetype: process }
    node c3 { label: "·", archetype: process }
    node j6 { label: "·", archetype: process }

    // ── 湖仓支路 ──
    node c4 { label: "·", archetype: process }
    node n10 { label: "归档", archetype: process }
    node n11 { label: "发布", archetype: process }      // 汇聚点

    // 顶层四路扇出
    n0 -> n1
    n0 -> j1
    n0 -> n3
    n0 -> n_sink                    // 右侧 bypass 长边

    // 路由三分支
    n1 -> j2
    n1 -> c1
    n1 -> n4

    // 左路 → 去重 → 发布
    j2 -> n5
    j2 -> j3
    j2 -> n7
    n5 -> n8
    j3 -> n6
    n6 -> n8
    n7 -> c2
    c2 -> j4
    j4 -> n8
    n8 -> n11

    // 中路直达
    c1 -> n11

    // 右路 → 发布
    n4 -> j5
    n4 -> c3
    j5 -> n9
    n9 -> n11
    c3 -> j6
    j6 -> n11

    // 湖仓支路
    j1 -> n2
    n2 -> c4
    c4 -> n11
    c4 -> n10
    n10 -> n_sink

    // 其余汇流
    n3 -> n_sink
    n11 -> n_sink
}
