// 多自环场景：重试、状态回退、轮询
diagram {
    profile: flowchart
    title: "重试与回退流程"
    layout: hierarchical { direction: top-to-bottom }

    node init { label: "初始化", archetype: start }
    node fetch { label: "获取数据", archetype: process }
    node check { label: "数据有效？", archetype: decision }
    node transform { label: "转换处理", archetype: process }
    node validate { label: "校验通过？", archetype: decision }
    node save { label: "保存结果", archetype: process }
    node done { label: "完成", archetype: end }

    init -> fetch
    fetch -> check
    check -> transform "有效"
    check -> fetch "无效，重试"
    transform -> validate
    validate -> save "通过"
    validate -> transform "失败，重做"
    save -> done
}
