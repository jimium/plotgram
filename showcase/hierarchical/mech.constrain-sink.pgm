// constrain 示例：无业务边强制 sink 沉底
//
// side 与 end 之间没有业务边，但 `constrain side -> end` 强制 end 在下游。
diagram {
    profile: flowchart
    title: "constrain sink"

    node start { label: "开始", archetype: start }
    node a { label: "处理", archetype: process }
    node side { label: "旁路", archetype: process }
    node end { label: "结束", archetype: end }

    start -> a
    a -> side
    side -> a
    a -> end

    // 隐形硬约束：side 上游、end 下游（不画边）
    // constrain（旧语法，新规范暂无对应；保留注释）
    // constrain side -> end
}
