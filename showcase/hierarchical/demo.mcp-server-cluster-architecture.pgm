// MCP 服务集群架构：客户端 → 入口 → 无状态服务 → 共享状态
// Mermaid 对照: flowchart LR 四组分层结构
diagram {
    profile: architecture
    title: "MCP 服务集群架构"

    group clients {
        label: "客户端"
        node cursor { label: "Cursor MCP", archetype: frontend }
        node studio { label: "Studio", archetype: frontend }
    }

    group edge {
        label: "入口"
        node lb { label: "LB / API Gateway", archetype: gateway }
    }

    group stateless {
        label: "无状态（可水平扩展）"
        node mcp_server_1 { label: "mcp-server-1", archetype: service }
        node mcp_server_2 { label: "mcp-server-2", archetype: service }
        node mcp_server_n { label: "mcp-server-n", archetype: service }
    }

    group shared {
        label: "共享状态"
        node pg { label: "Postgres\ndiagram + revision 元数据", archetype: database
            meta.semantic: postgres
        }
        node redis { label: "Redis\n可选：锁 / 缓存", archetype: cache
            meta.semantic: redis
        }
        node object_store { label: "Object Store\n大 DSL / 渲染缓存", archetype: storage
            meta.semantic: s3
        }
    }

    cursor -> lb
    studio -> lb
    lb -> mcp_server_1
    lb -> mcp_server_2
    lb -> mcp_server_n
    mcp_server_1 -> pg
    mcp_server_2 -> pg
    mcp_server_n -> pg
    mcp_server_1 -> redis
    mcp_server_2 -> redis
    mcp_server_1 -> object_store
}
