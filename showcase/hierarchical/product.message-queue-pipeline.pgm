// 消息队列异步处理架构：生产者 → 队列 → 消费者
// 业务场景: 订单系统削峰填谷的异步解耦拓扑
// Mermaid 对照: graph + 队列中枢
diagram {
    profile: architecture
    title: "消息队列异步处理架构"
    layout: architecture
theme: common.clean-light

    group producer {
        label: "生产端"
        node order_svc { label: "订单服务", archetype: service }
        node user_svc { label: "用户服务", archetype: service }
    }

    group broker {
        label: "消息中间件"
        node kafka { label: "Kafka", archetype: queue
            meta.semantic: kafka
        }
    }

    group consumer {
        label: "消费端"
        node email_svc { label: "邮件服务", archetype: service }
        node point_svc { label: "积分服务", archetype: service }
        node stat_svc { label: "统计服务", archetype: service }
    }

    group store {
        label: "持久化"
        node db { label: "PostgreSQL", archetype: database
            meta.semantic: postgres
        }
    }

    order_svc -> kafka "发布 order.created"
    user_svc -> kafka "发布 user.registered"
    kafka -> email_svc "订阅"
    kafka -> point_svc "订阅"
    kafka -> stat_svc "订阅"
    point_svc -> db "写积分"
    stat_svc -> db "写统计"
}
