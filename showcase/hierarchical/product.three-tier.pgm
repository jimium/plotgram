// 经典三层架构：Client → API → DB
// Mermaid 对照: graph LR 三层结构
diagram {
    profile: architecture
    title: "三层架构"

    node client { label: "客户端", archetype: frontend
        meta.semantic: browser
    }
    node api { label: "API 服务", archetype: service }
    node db { label: "数据库", archetype: database
        meta.semantic: postgres
    }

    client -> api "HTTP 请求"
    api -> db "SQL 查询"
    db --> api "查询结果"
    api --> client "JSON 响应"
}
