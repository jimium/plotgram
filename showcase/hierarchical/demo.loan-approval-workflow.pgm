// 贷款审批工作流：申请 → 风控 → 授信 → 放款
// 业务场景: 消费金融贷款自动化审批全链路，含反欺诈与人工复核
// Mermaid 对照: 复杂 graph TD，含 group 分段与多决策回环
diagram {
    profile: flowchart
    title: "贷款审批工作流"
    layout: hierarchical { direction: top-to-bottom }

    group intake {
        label: "受理阶段"
        node apply { label: "提交贷款申请", archetype: start }
        node collect { label: "采集资料", archetype: process }
        node complete_gate { label: "资料是否完整？", archetype: decision }
        node supplement { label: "补充材料", archetype: process }
    }

    group risk {
        label: "风控阶段"
        node anti_fraud { label: "反欺诈校验", archetype: process }
        node fraud_gate { label: "是否命中欺诈？", archetype: decision }
        node credit_score { label: "信用评分", archetype: process }
        node score_gate { label: "评分是否达标？", archetype: decision }
        node manual_review { label: "人工复核", archetype: process }
        node manual_gate { label: "复核结论？", archetype: decision }
    }

    group grant {
        label: "授信放款"
        node set_limit { label: "核定额度", archetype: process }
        node sign { label: "电子签约", archetype: process }
        node disburse { label: "放款到账", archetype: process }
        node approved { label: "放款完成", archetype: end }
        node rejected { label: "申请拒绝", archetype: end }
    }

    apply -> collect
    collect -> complete_gate
    complete_gate -> anti_fraud "完整"
    complete_gate -> supplement "缺失"
    supplement -> collect "补齐后重提"

    anti_fraud -> fraud_gate
    fraud_gate -> rejected "命中"
    fraud_gate -> credit_score "通过"
    credit_score -> score_gate
    score_gate -> set_limit "达标"
    score_gate -> manual_review "临界"
    manual_review -> manual_gate
    manual_gate -> set_limit "通过"
    manual_gate -> rejected "拒绝"

    set_limit -> sign
    sign -> disburse
    disburse -> approved
}
