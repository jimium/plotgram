// 请假审批流程：员工提交 → 直属主管 → HR 备案 → 结果通知
// 业务场景: 企业 OA 系统的请假审批，含天数判断与驳回回环
// Mermaid 对照: graph TD + decision 分支与回环
diagram {
    profile: flowchart
    title: "请假审批流程"
    layout: hierarchical { direction: top-to-bottom }

    node submit { label: "员工提交请假", archetype: start }
    node fill_form { label: "填写请假单", archetype: process }
    node days_gate { label: "请假天数 > 3 天？", archetype: decision }
    node lead_review { label: "直属主管审批", archetype: process }
    node director_review { label: "部门总监审批", archetype: process }
    node approve_gate { label: "是否批准？", archetype: decision }
    node hr_record { label: "HR 备案存档", archetype: process }
    node notify_pass { label: "通知：审批通过", archetype: process }
    node notify_reject { label: "通知：审批驳回", archetype: process }
    node done { label: "流程结束", archetype: end }

    submit -> fill_form
    fill_form -> days_gate
    days_gate -> lead_review "否"
    days_gate -> director_review "是"
    lead_review -> approve_gate
    director_review -> approve_gate
    approve_gate -> hr_record "批准"
    approve_gate -> notify_reject "驳回"
    hr_record -> notify_pass
    notify_pass -> done
    notify_reject -> fill_form "修改后重新提交"
}
