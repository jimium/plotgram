// 无 group 冒烟：网关扇出到双服务再汇入存储
// 用途：覆盖单层布局的 fan-out / fan-in，对照有 group 路径
diagram {
    profile: architecture
    title: "无分组：网关扇出"

    node gw { label: "网关", archetype: gateway }
    node a { label: "服务 A", archetype: service }
    node b { label: "服务 B", archetype: service }
    node db { label: "数据库", archetype: database
        meta.semantic: postgres
    }

    gw -> a
    gw -> b
    a -> db
    b -> db
}
