// 微服务架构：group 分组 + 跨组连线
// Mermaid 对照: graph + subgraph 前端/后端分组
diagram {
    profile: architecture,
    title: "微服务架构"

    group frontend {
        label: "前端层"
        node web { label: "Web 客户端", archetype: frontend,
            meta.semantic: browser
        }
        node mobile { label: "移动客户端", archetype: frontend,
            meta.semantic: mobile
        }
    }

    group backend {
        label: "后端层"
        node gateway { label: "API 网关", archetype: gateway,
            meta.semantic: nginx
        }
        node user_svc { label: "用户服务", archetype: service }
        node order_svc { label: "订单服务", archetype: service }
    }

    node db { label: "PostgreSQL", archetype: database,
        meta.semantic: postgres
    }
    node mq { label: "消息队列", archetype: queue,
        meta.semantic: kafka
    }

    web -> gateway
    mobile -> gateway
    gateway -> user_svc
    gateway -> order_svc
    user_svc -> db
    order_svc -> db
    order_svc -> mq "发布订单事件"
    mq --> user_svc "消费事件"
}
