// 客户退款流程：申请受理 → 审核 → 财务处理三段
// Mermaid 对照: 复杂电商退款流程图，含 group 分段与回环
diagram {
    profile: flowchart,
    title: "客户退款流程",
    layout: hierarchical { direction: top-to-bottom }

    group intake {
        label: "申请受理"
        node request { label: "提交退款申请", archetype: start }
        node classify { label: "退款类型识别", archetype: process }
        node classify_gate { label: "是否符合政策？", archetype: decision }
        node collect_evidence { label: "补充凭证材料", archetype: process }
        node evidence_gate { label: "材料齐全？", archetype: decision }
        node reject { label: "拒绝退款", archetype: process }
        node rejected_end { label: "申请关闭", archetype: end }
    }

    group review {
        label: "审核阶段"
        node cs_review { label: "客服初审", archetype: process }
        node cs_gate { label: "客服通过？", archetype: decision }
        node supervisor { label: "主管复核", archetype: process }
        node sup_gate { label: "复核通过？", archetype: decision }
        node fraud_check { label: "反欺诈核查", archetype: process }
        node fraud_gate { label: "存在风险？", archetype: decision }
        node escalate { label: "升级风控团队", archetype: process }
        node back_to_cs { label: "退回客服补充", archetype: process }
    }

    group finance {
        label: "财务处理"
        node approve { label: "审批通过", archetype: process }
        node refund_calc { label: "退款金额计算", archetype: process }
        node refund_pay { label: "执行退款", archetype: process }
        node pay_gate { label: "退款到账？", archetype: decision }
        node retry_pay { label: "重新发起退款", archetype: process }
        node notify { label: "通知客户", archetype: process }
        node archive { label: "归档与对账", archetype: process }
        node done { label: "退款完成", archetype: end }
    }

    request -> classify
    classify -> classify_gate
    classify_gate -> collect_evidence "是"
    classify_gate -> reject "否"
    reject -> rejected_end

    collect_evidence -> evidence_gate
    evidence_gate -> cs_review "是"
    evidence_gate -> collect_evidence "否，要求补齐"

    cs_review -> cs_gate
    cs_gate -> supervisor "是"
    cs_gate -> back_to_cs "否"
    back_to_cs -> cs_review "补充后重审"

    supervisor -> sup_gate
    sup_gate -> fraud_check "是"
    sup_gate -> back_to_cs "否"

    fraud_check -> fraud_gate
    fraud_gate -> escalate "是"
    fraud_gate -> approve "否"
    escalate -> reject "确认欺诈"

    approve -> refund_calc
    refund_calc -> refund_pay
    refund_pay -> pay_gate
    pay_gate -> notify "是"
    pay_gate -> retry_pay "否"
    retry_pay -> pay_gate "再次校验"

    notify -> archive
    archive -> done
}
