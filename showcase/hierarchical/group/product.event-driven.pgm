// 事件驱动架构：生产者-消费者模式
// Mermaid 对照: graph + subgraph + 异步消息流
diagram {
    profile: architecture,
    title: "事件驱动架构"

    group producers {
        label: "生产者"
        node order_svc { label: "订单服务", archetype: service }
        node user_svc { label: "用户服务", archetype: service }
    }

    group messaging {
        label: "消息中间件"
        node kafka { label: "Kafka", archetype: queue }
    }

    group consumers {
        label: "消费者"
        node analytics { label: "分析服务", archetype: service }
        node notify { label: "通知服务", archetype: service }
        node search { label: "搜索服务", archetype: service }
    }

    order_svc -> kafka "OrderCreated"
    user_svc -> kafka "UserRegistered"
    kafka --> analytics
    kafka --> notify
    kafka --> search
}
