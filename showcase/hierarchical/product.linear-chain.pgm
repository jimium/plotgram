// 经典线性链：A → B → C
// Mermaid 对照: graph LR; A[开始] --> B[处理] --> C[结束]
diagram {
    profile: flowchart
    title: "线性流程"
    layout: hierarchical { direction: left-to-right }

    node start { label: "开始", archetype: start }
    node process { label: "处理", archetype: process }
    node end { label: "结束", archetype: end }

    start -> process
    process -> end
}
