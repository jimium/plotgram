// AI 学习路线思维导图
// 业务场景：系统化的 AI 学习路径规划，涵盖数学基础、机器学习、深度学习到工程实践的完整知识体系
// Mermaid 对照: 复杂 mindmap 多层级知识树
diagram mindmap {
    title: "AI 学习路线"

    entity[root] ai_roadmap "AI 学习路线"

    entity[main] math "数学基础"
    entity[branch] linear_algebra "线性代数"
    entity[branch] calculus "微积分"
    entity[branch] probability "概率与统计"
    entity[branch] optimization "最优化方法"

    entity[main] ml "机器学习"
    entity[branch] supervised "监督学习"
    entity[branch] unsupervised "无监督学习"
    entity[branch] feature_eng "特征工程"
    entity[leaf] fe_encoding "编码与变换"
    entity[leaf] fe_selection "特征选择"
    entity[leaf] fe_scale "归一化与标准化"
    entity[leaf] fe_extraction "特征提取"
    entity[branch] model_eval "模型评估与调优"

    entity[main] dl "深度学习"
    entity[branch] cnn "卷积神经网络"
    entity[branch] rnn "循环神经网络"
    entity[branch] transformer "Transformer"
    entity[branch] gan "生成对抗网络"

    entity[main] practice "工程实践"
    entity[branch] frameworks "深度学习框架"
    entity[branch] mlops "MLOps"
    entity[branch] deploy "模型部署"
    entity[branch] projects "项目实战"

    ai_roadmap -> math "基础"
    ai_roadmap -> ml "核心"
    ai_roadmap -> dl "进阶"
    ai_roadmap -> practice "落地"

    math -> linear_algebra "矩阵运算"
    math -> calculus "求导与梯度"
    math -> probability "贝叶斯"
    math -> optimization "凸优化"

    ml -> supervised "回归/分类"
    ml -> unsupervised "聚类/降维"
    ml -> feature_eng "数据预处理"
    ml -> model_eval "交叉验证"

    feature_eng -> fe_encoding "独热/Label编码"
    feature_eng -> fe_selection "过滤/包裹/嵌入"
    feature_eng -> fe_scale "MinMax/标准分数"
    feature_eng -> fe_extraction "PCA/LDA"

    dl -> cnn "图像处理"
    dl -> rnn "序列建模"
    dl -> transformer "注意力机制"
    dl -> gan "数据生成"

    practice -> frameworks "PyTorch/TF"
    practice -> mlops "实验管理"
    practice -> deploy "ONNX/TensorRT"
    practice -> projects "Kaggle/竞赛"
}
