// 配送跟踪状态机：待取件 → 运输 → 派送 → 签收
// 业务场景: 物流订单的配送状态跟踪
// Mermaid 对照: stateDiagram-v2 物流状态
// @role: product  (authoritative: filename prefix)
diagram state {
    title: "配送跟踪状态"

    entity[initial] init ""
    entity[state] pending "待揽收"
    entity[state] in_transit "运输中"
    entity[state] out_delivery "派送中"
    entity[state] exception "配送异常"
    entity[final] delivered "已签收"
    entity[final] returned "已退回"

    init -> pending
    pending -> in_transit "已揽收"
    in_transit -> out_delivery "到达网点"
    out_delivery -> delivered "客户签收"
    out_delivery -> exception "投递失败"
    exception -> out_delivery "重新派送"
    exception -> returned "多次失败退回"
}
